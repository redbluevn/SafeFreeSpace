<Window x:Class="SafeFreeSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SafeFreeSpace.App.Views"
        xmlns:vm="clr-namespace:SafeFreeSpace.App.ViewModels"
        Title="{DynamicResource AppTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" Padding="8">
            <TextBlock Text="{DynamicResource DevBuildWarning}" FontWeight="Bold" HorizontalAlignment="Center" />
        </Border>

        <ToolBarTray Grid.Row="1" IsLocked="True">
            <ToolBar>
                <Button Content="{DynamicResource RefreshButton}" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource HistoryButton}" Command="{Binding ShowHistoryCommand}" />
                <Button Content="{DynamicResource SettingsButton}" Command="{Binding ShowSettingsCommand}" />
                <Button Content="{DynamicResource HelpButton}" Command="{Binding ShowHelpCommand}" />
            </ToolBar>
            <ToolBar>
                <CheckBox Content="{DynamicResource AdvancedMode}" IsChecked="{Binding IsAdvancedMode}" VerticalAlignment="Center" />
            </ToolBar>
        </ToolBarTray>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringEmptyToVisibilityConverter}}" />

        <Grid Grid.Row="3" Margin="8" x:Name="ContentGrid">
            <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource SelectVolume}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VolumeCardViewModel}">
                                <views:VolumeCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource ConfirmationTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Text="{Binding Confirmation.VolumeSummary}" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="{Binding Confirmation.EstimatedDurationText}" FontSize="14" Foreground="Gray" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="{Binding Confirmation.Disclaimer}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Grid.Row="3" Text="{DynamicResource ConfirmationInstruction}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" Text="{Binding Confirmation.ExpectedPhrase}" FontWeight="Bold" Foreground="DarkRed" Margin="0,20,0,4" />
                <TextBox Grid.Row="4" Text="{Binding Confirmation.Phrase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="4" Text="{Binding Confirmation.CountdownText}" Foreground="Gray" Margin="0,32,0,0" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CancelButton}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource StartButton}" Command="{Binding Confirmation.StartCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource ProgressTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="{Binding Operation.ElapsedText, StringFormat='Thời gian: {0}'}" Margin="0,0,0,8" />
                <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="{Binding Operation.IsProgressIndeterminate}" Margin="0,0,0,8" />
                <Border Grid.Row="3" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Operation.OutputLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Button Grid.Row="4" Content="{DynamicResource CancelButton}" Command="{Binding Operation.CancelCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>

            <Grid Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource ResultTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="14" />
                <Button Grid.Row="2" Content="{DynamicResource OkButton}" Command="{Binding ResultOkCommand}" HorizontalAlignment="Right" IsDefault="True" />
            </Grid>

            <Grid Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource HistoryTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryEntryViewModel}">
                                <TextBlock Text="{Binding Summary}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Content="{DynamicResource BackButton}" Command="{Binding BackCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>

            <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource SettingsTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Text="{DynamicResource AboutText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Grid.Row="2" Content="{DynamicResource BackButton}" Command="{Binding BackCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>

            <Grid Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource HelpTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <FlowDocumentScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <FlowDocument FontFamily="Segoe UI" FontSize="13" LineHeight="18" PagePadding="8">
                        <Paragraph FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">
                            SafeFreeSpace giúp giảm khả năng khôi phục dữ liệu đã xóa trong vùng trống của ổ đĩa.
                        </Paragraph>

                        <Paragraph FontSize="15" FontWeight="Bold" Margin="0,12,0,4">
                            1. Chọn volume
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,8">
                            <ListItem>
                                <Paragraph>Chỉ các ổ đĩa vật lý được liệt kê. Ổ ảo, ổ mạng (ví dụ Google Drive) không hiển thị.</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Ổ C: (Windows) là volume hệ thống; bật <Bold>"Chế độ nâng cao"</Bold> nếu muốn thao tác.</Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph FontSize="15" FontWeight="Bold" Margin="0,12,0,4">
                            2. Loại thao tác
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,8">
                            <ListItem>
                                <Paragraph><Bold>HDD (ổ cứng từ):</Bold> "Làm sạch vùng trống" — ghi đè vùng trống bằng <Italic>cipher.exe /w</Italic>.</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph><Bold>SSD/NVMe:</Bold> "Gửi lại TRIM" — yêu cầu hệ điều hành gửi lệnh TRIM để SSD tự xóa ô nhớ đã giải phóng.</Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph FontSize="15" FontWeight="Bold" Margin="0,12,0,4">
                            3. Xác nhận
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,8">
                            <ListItem>
                                <Paragraph>Nhập chính xác cụm xác nhận hiển thị trên màn hình (ví dụ: <Bold>RETRIM D:</Bold> hoặc <Bold>WIPE FREE SPACE C:</Bold>).</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Chờ đếm ngược 3 giây trước khi bấm <Bold>"Bắt đầu"</Bold>.</Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph FontSize="15" FontWeight="Bold" Margin="0,12,0,4">
                            4. Lưu ý an toàn
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,8">
                            <ListItem>
                                <Paragraph>Thao tác chỉ ảnh hưởng vùng trống, không xóa file hiện có.</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Không nên tắt máy hoặc rút ổ trong khi đang chạy.</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>SSD cần hỗ trợ TRIM; hiệu quả phụ thuộc firmware ổ.</Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph FontSize="15" FontWeight="Bold" Margin="0,12,0,4">
                            5. Lịch sử
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,0">
                            <ListItem>
                                <Paragraph>Mọi thao tác được ghi lại trong mục <Bold>"Lịch sử"</Bold>.</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Bạn có thể xóa lịch sử bất cứ lúc nào.</Paragraph>
                            </ListItem>
                        </List>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
                <Button Grid.Row="2" Content="{DynamicResource BackButton}" Command="{Binding BackCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
