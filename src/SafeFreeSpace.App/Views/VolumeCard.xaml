<UserControl x:Class="SafeFreeSpace.App.Views.VolumeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="8">
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="28" FontWeight="Bold" Text="{Binding DriveLetter}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                <TextBlock FontWeight="Bold" Text="{Binding Label, TargetNullValue=(không có nhãn)}" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Columns="3" Margin="0,8">
                <TextBlock Text="{Binding FileSystem, StringFormat='Hệ thống tệp: {0}'}" />
                <TextBlock Text="{Binding CapacityText, StringFormat='Dung lượng: {0}'}" />
                <TextBlock Text="{Binding FreeText, StringFormat='Trống: {0}'}" />
                <TextBlock Text="{Binding MediaType, StringFormat='Loại ổ: {0}'}" />
                <TextBlock Text="{Binding BusType, StringFormat='Bus: {0}'}" />
                <TextBlock Text="{Binding BitLockerState, StringFormat='BitLocker: {0}'}" />
                <TextBlock Text="{Binding Model, StringFormat='Model: {0}', TargetNullValue='Model: không rõ'}" />
                <TextBlock Text="{Binding HealthStatus, StringFormat='Sức khỏe: {0}', TargetNullValue='Sức khỏe: không rõ'}" />
            </UniformGrid>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontStyle="Italic" />
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EstimatedDurationText}" Foreground="Gray" Margin="0,4,0,0" />

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Content="{Binding ActionText}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEligible}" Margin="0,8,0,0" />
        </Grid>
    </Border>
</UserControl>
